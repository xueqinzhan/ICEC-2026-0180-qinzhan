+        const ctx = canvas.getContext('2d');
+        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
+        
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        
+        if (data.length === 0) return;
+        
+        const padding = 50;
+        const chartWidth = canvas.width - padding * 2;
+        const chartHeight = canvas.height - padding * 2;
+        
+        const minSignal = Math.min(...data.map(d => d.signal));
+        const maxSignal = Math.max(...data.map(d => d.signal));
+        const signalRange = maxSignal - minSignal || 10;
+        
+        // Draw grid
+        ctx.strokeStyle = isDark ? '#4a5568' : '#e2e8f0';
+        ctx.lineWidth = 1;
+        for (let i = 0; i <= 4; i++) {
+            const y = padding + (chartHeight / 4) * i;
+            ctx.beginPath();
+            ctx.moveTo(padding, y);
+            ctx.lineTo(canvas.width - padding, y);
+            ctx.stroke();
+            
+            // Y-axis labels
+            const val = Math.round(maxSignal - (signalRange / 4) * i);
+            ctx.fillStyle = isDark ? '#a0aec0' : '#718096';
+            ctx.font = '12px sans-serif';
+            ctx.textAlign = 'right';
+            ctx.fillText(val + 'dBm', padding - 8, y + 4);
+        }
+        
+        // Draw line
+        ctx.strokeStyle = '#667eea';
+        ctx.lineWidth = 3;
+        ctx.beginPath();
+        
+        data.forEach((point, i) => {
+            const x = padding + (chartWidth / (data.length - 1 || 1)) * i;
+            const y = padding + chartHeight - ((point.signal - minSignal) / signalRange) * chartHeight;
+            
+            if (i === 0) ctx.moveTo(x, y);
+            else ctx.lineTo(x, y);
+        });
+        ctx.stroke();
+        
+        // Draw points
+        data.forEach((point, i) => {
+            const x = padding + (chartWidth / (data.length - 1 || 1)) * i;
+            const y = padding + chartHeight - ((point.signal - minSignal) / signalRange) * chartHeight;
+            
+            ctx.fillStyle = getSigColor(getSignalClass(point.signal));
+            ctx.beginPath();
+            ctx.arc(x, y, 6, 0, Math.PI * 2);
+            ctx.fill();
+            
+            // X-axis labels
+            ctx.fillStyle = isDark ? '#a0aec0' : '#718096';
+            ctx.font = '10px sans-serif';
+            ctx.textAlign = 'center';
+            const label = point.name.length > 6 ? point.name.substring(0, 6) + '...' : point.name;
+            ctx.fillText(label, x, canvas.height - 10);
+        });
